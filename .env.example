# Copy this file to ".env" and fill in real values. Never commit the real .env.

# =========================================================================
# LLM PROVIDER (pick ONE) — the code works with any OpenAI-compatible API.
# =========================================================================

# --- Option A: Groq (FREE, recommended for this project) ---
# 1. Sign up at https://console.groq.com  ->  API Keys  ->  Create API Key
# 2. Uncomment the 3 lines below and paste your key.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# --- Option B: OpenAI (needs billing credit) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key-here
# LLM_MODEL=gpt-4o-mini

# If you leave all of the above blank, the pipeline runs in MOCK mode
# (fake rewrites, no API calls) so you can still test everything.

# =========================================================================
# Google Sheets (Stage C — optional)
# =========================================================================
# The long ID in your sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your-sheet-id-here
# Path to the service-account JSON you download from Google Cloud Console
GOOGLE_CREDS_PATH=./google_creds.json

# =========================================================================
# Scoring config
# =========================================================================
# Listings scoring below this get flagged "needs_fix" (and queued for rewrite)
FIX_THRESHOLD=60
